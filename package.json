{
  "name": "stockmesh",
  "version": "0.1.0",
  "private": true,
  "description": "StockMesh replayable network-analysis foundation",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:web",
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev": "tsx src/server/main.ts",
    "dev:web": "vite",
    "start": "node dist/server/main.js",
    "typecheck": "npm run typecheck:core && npm run typecheck:web",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify:licenses": "node scripts/verify-dependency-licenses.mjs",
    "normalize:lock-registry": "node scripts/normalize-lockfile-registry.mjs",
    "migrate": "tsx src/cli/migrate.ts",
    "stockmesh": "tsx src/cli/stockmesh.ts",
    "pilot": "tsx src/cli/pilot.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "better-sqlite3": "12.11.1",
    "cytoscape": "3.33.1",
    "echarts": "6.1.0",
    "fastify": "5.10.0",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-components": "1.5.4",
    "graphology-metrics": "2.4.0",
    "graphology-shortest-path": "2.1.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/cytoscape": "3.21.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
